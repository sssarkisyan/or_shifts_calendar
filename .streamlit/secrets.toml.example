# Скопируйте этот файл в .streamlit/secrets.toml для локальной проверки с
# реальной Google-таблицей (сам secrets.toml никогда не коммитится — см.
# .gitignore). При деплое на Streamlit Community Cloud эти же значения
# вводятся через раздел "Secrets" в настройках приложения, а не через файл.

manager_passcode = "241024"

[sheet]
spreadsheet_id = "ВСТАВЬТЕ_ID_ИЗ_ССЫЛКИ_НА_ТАБЛИЦУ"

[gcp_service_account]
type = "service_account"
project_id = "ваш-проект"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\nВСТАВЬТЕ_КЛЮЧ_СО_ВСТАВЛЕННЫМИ_\\n\n-----END PRIVATE KEY-----\n"
client_email = "orit-bot@ваш-проект.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
